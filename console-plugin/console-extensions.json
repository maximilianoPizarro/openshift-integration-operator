[
  {
    "type": "console.navigation/section",
    "properties": {
      "id": "integration-platform",
      "name": "Integration Platform"
    }
  },
  {
    "type": "console.navigation/href",
    "properties": {
      "id": "flow-overview",
      "name": "Overview",
      "href": "/integration-overview",
      "section": "integration-platform"
    }
  },
  {
    "type": "console.navigation/href",
    "properties": {
      "id": "integration-flows",
      "name": "Integration Flows",
      "href": "/integration-flows",
      "section": "integration-platform"
    }
  },
  {
    "type": "console.navigation/href",
    "properties": {
      "id": "platform-status",
      "name": "Platform Status",
      "href": "/integration-status",
      "section": "integration-platform"
    }
  },
  {
    "type": "console.page/route",
    "properties": {
      "exact": true,
      "path": "/integration-overview",
      "component": {
        "$codeRef": "flowOverviewPage.FlowOverviewPage"
      }
    }
  },
  {
    "type": "console.page/route",
    "properties": {
      "exact": true,
      "path": "/integration-flows",
      "component": {
        "$codeRef": "integrationFlowPage.IntegrationFlowPage"
      }
    }
  },
  {
    "type": "console.page/route",
    "properties": {
      "exact": true,
      "path": "/integration-flows/:name",
      "component": {
        "$codeRef": "flowDesignerPage.FlowDesignerPage"
      }
    }
  },
  {
    "type": "console.page/route",
    "properties": {
      "exact": true,
      "path": "/integration-status",
      "component": {
        "$codeRef": "platformStatusPage.PlatformStatusPage"
      }
    }
  }
]
